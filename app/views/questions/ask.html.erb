<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <h1 class="mb-4">Ask your coach anything</h1>
      <form action="/answer" data-turbo="false">
        <div class="mb-3">
          <label for="question" class="form-label">Your question</label>
          <input type="text" id="question" name="question" class="form-control" placeholder="Type your question here...">
        </div>
        <input type="submit" value="Ask!" class="btn btn-primary">
      </form>
    </div>
  </div>
</div>
